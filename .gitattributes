* text=auto eol=lf

# 容器与 CI 里要执行的脚本必须是 LF，否则报 bad interpreter: /bin/sh^M
*.sh   text eol=lf
Dockerfile       text eol=lf
*.conf           text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf

# Windows 批处理保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.db   binary
