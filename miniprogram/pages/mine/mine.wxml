<view class="page mine-page {{dark ? 'theme-dark' : ''}}" style="{{primaryStyle}}">
  <nav-bar title="我的"  center />

  <!-- 个人信息 -->
  <view class="profile-card">
    <!-- open-type="chooseAvatar" 的 button 内部放子节点时，部分基础库下 bindchooseavatar 不触发。
         这里让 button 作为透明热区覆盖在头像之上，button 自身保持无子节点。 -->
    <view class="avatar-wrap">
      <image class="avatar" src="{{avatarUrl || '/images/tab/user.png'}}" mode="aspectFill" />
      <view class="avatar-mask">{{uploadingAvatar ? '上传中' : '更换'}}</view>
      <button class="avatar-hit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" />
    </view>
    <view class="p-info">
      <view class="p-name ellipsis">{{user.nickname || '未命名用户'}}</view>
      <view class="p-tags">
        <status-tag wx:if="{{user && user.role === 'admin'}}" text="管理员" kind="primary" />
        <status-tag text="{{_statusText}}" kind="{{_statusKind}}" dot />
      </view>
    </view>
  </view>

  <!-- 待审批提示 -->
  <view class="notice notice-warning" wx:if="{{_isPending}}">
    <image class="n-icon" src="/images/icons/info-ink.png" mode="aspectFit" />
    <view class="grow">
      <view>账号待管理员审批。请先「完善资料」填写微信号 / 手机号，方便管理员核对。</view>
      <view class="n-link" bindtap="openProfile">立即完善资料 →</view>
    </view>
  </view>

  <!-- 管理员专区 -->
  <block wx:if="{{isAdmin}}">
    <view class="section-cap">管理员</view>
    <view class="menu-card" bindtap="goAdminHome">
      <view class="list-icon"><image src="/images/icons/users.png" mode="aspectFit" /></view>
      <view class="grow">
        <view class="list-title">管理后台</view>
        <view class="list-sub">用户审批 · 任务审批 · 打印机 · 系统设置</view>
      </view>
      <view class="list-arrow"></view>
    </view>
    <view class="menu-card" bindtap="onScanQr">
      <view class="list-icon"><image src="/images/icons/scan.png" mode="aspectFit" /></view>
      <view class="grow">
        <view class="list-title">扫码登录后台</view>
        <view class="list-sub">扫描网页管理台的登录二维码</view>
      </view>
      <view class="list-arrow"></view>
    </view>
  </block>

  <block wx:elif="{{user}}">
    <!-- 已审批的普通用户：扫码把微信绑到后台已有的账号上 -->
    <block wx:if="{{user.status === 'approved'}}">
      <view class="section-cap">账号</view>
      <view class="menu-card" bindtap="scanBindAccount">
        <view class="list-icon"><image src="/images/icons/scan.png" mode="aspectFit" /></view>
        <view class="grow">
          <view class="list-title">扫码绑定账号</view>
          <view class="list-sub">扫后台「用户 → 扫码绑定」生成的二维码，绑定到已有账号</view>
        </view>
        <view class="list-arrow"></view>
      </view>
    </block>

    <view class="section-cap">成为管理员</view>
    <view class="menu-card" bindtap="openBind">
      <view class="list-icon"><image src="/images/icons/key.png" mode="aspectFit" /></view>
      <view class="grow">
        <view class="list-title">绑定管理员</view>
        <view class="list-sub">输入后台「微信对接」页生成的绑定码</view>
      </view>
      <view class="list-arrow"></view>
    </view>
  </block>

  <!-- 账号 -->
  <view class="section-cap">账号</view>
  <view class="menu-card" bindtap="openProfile">
    <view class="list-icon"><image src="/images/icons/user.png" mode="aspectFit" /></view>
    <view class="grow">
      <view class="list-title">完善资料</view>
      <view class="list-sub">昵称 / 微信号 / 手机号 / 姓名</view>
    </view>
    <view class="list-value">{{_profileDone ? '已填写' : '待补充'}}</view>
    <view class="list-arrow"></view>
  </view>

  <!-- 通用 -->
  <view class="section-cap">通用</view>
  <view class="menu-card" bindtap="openBase">
    <view class="list-icon"><image src="/images/icons/server.png" mode="aspectFit" /></view>
    <view class="grow">
      <view class="list-title">服务地址</view>
      <view class="list-sub">PrintGate 后端访问地址</view>
    </view>
    <view class="list-value ellipsis" style="max-width: 240rpx;">{{baseUrl || '未配置'}}</view>
    <view class="list-arrow"></view>
  </view>
  <view class="menu-card" bindtap="openTheme">
    <view class="list-icon"><image src="/images/icons/sliders.png" mode="aspectFit" /></view>
    <view class="grow">
      <view class="list-title">显示与主题</view>
      <view class="list-sub">浅色 / 暗夜 / 跟随系统 · 主题色</view>
    </view>
    <view class="list-value">{{themeLabel}}</view>
    <view class="list-arrow"></view>
  </view>
  <view class="menu-card" bindtap="openAbout">
    <view class="list-icon"><image src="/images/icons/info.png" mode="aspectFit" /></view>
    <view class="grow">
      <view class="list-title">关于 PrintGate</view>
      <view class="list-sub">版本与说明</view>
    </view>
    <view class="list-value">v{{version}}</view>
    <view class="list-arrow"></view>
  </view>
  <view class="menu-card" bindtap="askLogout">
    <view class="list-icon list-icon-danger"><image src="/images/icons/logout-ink.png" mode="aspectFit" /></view>
    <view class="grow">
      <view class="list-title t-danger">退出登录</view>
    </view>
    <view class="list-arrow"></view>
  </view>

  <view class="footer-version">PrintGate v{{version}} · 云打印小程序</view>

  <!-- 资料编辑 -->
  <pg-sheet visible="{{showProfile}}" title="完善资料" bind:close="closeProfile">
    <view class="form-item">
      <text class="form-label">昵称<span class="req">*</span></text>
      <!-- type="nickname"：微信键盘会提供「使用微信昵称」一键填充（官方头像昵称填写能力） -->
      <input class="form-input" type="nickname" value="{{profile.nickname}}" placeholder="怎么称呼你（可一键用微信昵称）" placeholder-class="ph" bindinput="onProfileInput" data-k="nickname" />
    </view>
    <view class="form-item">
      <text class="form-label">微信号</text>
      <input class="form-input" value="{{profile.wechat_id}}" placeholder="便于管理员联系" placeholder-class="ph" bindinput="onProfileInput" data-k="wechat_id" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" value="{{profile.phone}}" placeholder="选填" placeholder-class="ph" bindinput="onProfileInput" data-k="phone" />
    </view>
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" value="{{profile.real_name}}" placeholder="选填" placeholder-class="ph" bindinput="onProfileInput" data-k="real_name" />
    </view>
    <view class="form-item" style="align-items: flex-start;">
      <text class="form-label" style="padding-top: 8rpx;">申请说明</text>
      <textarea class="form-input" value="{{profile.apply_note}}" placeholder="告诉管理员你的打印需求" placeholder-class="ph" bindinput="onProfileInput" data-k="apply_note" />
    </view>
    <view class="btn btn-primary btn-block mt-24" bindtap="saveProfile">保存资料</view>
  </pg-sheet>

  <!-- 绑定管理员 -->
  <pg-sheet visible="{{showBind}}" title="绑定管理员" bind:close="closeBind">
    <view class="sheet-tip">在 PrintGate 网页管理台「微信对接」页生成绑定码，填入后本微信即成为管理员。</view>
    <view class="sheet-input-box">
      <input class="sheet-input" value="{{bindToken}}" placeholder="请输入绑定码" placeholder-class="ph" bindinput="onBindInput" />
    </view>
    <view class="sheet-presets">
      <view class="chip" bindtap="scanBindToken">扫码填入绑定码</view>
    </view>
    <view class="btn btn-primary btn-block mt-24" bindtap="doBind">确认绑定</view>
  </pg-sheet>

  <!-- 扫码登录确认 -->
  <pg-sheet visible="{{showQrConfirm}}" title="确认登录" bind:close="closeQrConfirm">
    <view class="sheet-tip">已在网页管理台扫描二维码。点击「确认登录」后，网页将以此账号（{{user.nickname || ''}}）自动登录。</view>
    <view class="btn btn-primary btn-block mt-24" bindtap="confirmQr">确认登录</view>
    <view class="btn btn-block mt-16" bindtap="closeQrConfirm">取消</view>
  </pg-sheet>

  <!-- 服务地址 -->
  <pg-sheet visible="{{showBase}}" title="服务地址" bind:close="closeBase">
    <view class="sheet-tip">填写 PrintGate 服务端的访问地址，需与后台「小程序对接」页的接入地址一致；线上必须是已备案的 https 域名。</view>
    <view class="sheet-input-box">
      <input class="sheet-input" value="{{baseInput}}" placeholder="例如 https://print.example.com" placeholder-class="ph" bindinput="onBaseInput" />
    </view>
    <view class="sheet-presets">
      <view class="chip {{baseInput === 'http://127.0.0.1:8080' ? 'on' : ''}}" bindtap="usePreset" data-preset="http://127.0.0.1:8080">本机联调</view>
    </view>
    <view class="btn btn-primary btn-block mt-24" bindtap="saveBase">保存并连接</view>
  </pg-sheet>

  <!-- 主题选择 -->
  <pg-sheet visible="{{showTheme}}" title="显示与主题" bind:close="closeTheme">
    <view class="theme-opt {{themeMode === item.key ? 'on' : ''}}" wx:for="{{themeModes}}" wx:key="key" bindtap="setTheme" data-mode="{{item.key}}">
      <view class="grow">
        <view class="theme-name">{{item.label}}</view>
        <view class="theme-desc">{{item.desc}}</view>
      </view>
      <image class="theme-check" src="/images/icons/check.png" mode="aspectFit" wx:if="{{themeMode === item.key}}" />
    </view>

    <!-- 主题色：主色可自定义，立即生效并持久化 -->
    <view class="theme-sub-cap">主题色</view>
    <view class="color-grid">
      <view class="color-dot {{primary === item.v ? 'on' : ''}}" wx:for="{{primaryList}}" wx:key="v"
            style="background: {{item.v}};" bindtap="setPrimaryColor" data-color="{{item.v}}">
        <!-- 勾用 CSS 画，避免在深浅不一的主色上看不清 -->
        <view class="color-check" wx:if="{{primary === item.v}}"></view>
      </view>
    </view>
    <view class="color-name">{{primaryName}}</view>

    <view class="sheet-tip mt-16">暗夜模式会同步调整页面、卡片、弹窗与导航配色；主题色在浅色/深色下都生效。</view>
  </pg-sheet>

  <!-- 关于 -->
  <pg-sheet visible="{{showAbout}}" title="关于 PrintGate" bind:close="closeAbout">
    <view class="about-logo"><image src="/images/logo.png" mode="aspectFit" /></view>
    <view class="about-name">PrintGate 云打印</view>
    <view class="about-desc">CUPS 打印网关配套小程序：上传文件、选择打印机、提交打印并跟踪记录。管理员可在小程序内审批用户与任务、管理打印机与打印策略。</view>
    <view class="about-row"><text>小程序版本</text><text>v{{version}}</text></view>
    <view class="about-row"><text>当前账号</text><text>{{_roleText}} · {{_statusText}}</text></view>
    <view class="about-row"><text>服务地址</text><text class="ellipsis" style="max-width: 320rpx;">{{baseUrl || '未配置'}}</text></view>
    <view class="about-row"><text>主题</text><text>{{themeLabel}}</text></view>
    <view class="about-row"><text>主题色</text><text>{{primaryName}}</text></view>
  </pg-sheet>

  <!-- 退出登录 -->
  <pg-dialog
    visible="{{showLogout}}"
    title="退出登录"
    content="退出后需要重新登录才能使用，确定退出？"
    ok-text="退出"
    danger
    bind:cancel="onLogoutCancel"
    bind:ok="onLogoutOk"
  />

  <!-- 隐私协议：chooseAvatar / scanCode 属于隐私接口，需在本页挂载弹窗 -->
  <privacy-modal />
</view>
