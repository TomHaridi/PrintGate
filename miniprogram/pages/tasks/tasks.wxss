.filter-card { padding: 16rpx 20rpx; }
.tabs { width: 100%; }
.tab-wrap { display: flex; gap: 16rpx; }
.tab {
  flex-shrink: 0; height: 56rpx; line-height: 56rpx;
  padding: 0 26rpx; border-radius: 28rpx;
  background: var(--pg-fill); font-size: 24rpx; color: var(--pg-ink-2);
}
.tab.on { background: var(--pg-primary); color: var(--pg-on-primary); font-weight: 600; }

.task-row {
  background: var(--pg-card); border-radius: var(--pg-r-l);
  margin: 0 24rpx 20rpx; padding: 26rpx;
  box-shadow: var(--pg-shadow);
}
.t-head { display: flex; align-items: center; justify-content: space-between; }
.t-time { font-size: 22rpx; color: var(--pg-ink-3); }
.t-name { font-size: 28rpx; font-weight: 600; color: var(--pg-ink); margin-top: 16rpx; }
.t-meta { font-size: 23rpx; color: var(--pg-ink-3); margin-top: 8rpx; }
.t-error {
  font-size: 23rpx; color: var(--pg-danger);
  background: var(--pg-danger-soft); border-radius: 12rpx;
  padding: 14rpx 18rpx; margin-top: 16rpx; line-height: 1.5;
}
.t-foot { display: flex; justify-content: flex-end; margin-top: 18rpx; }
.t-cancel {
  font-size: 24rpx; color: var(--pg-danger);
  border: 2rpx solid var(--pg-danger); border-radius: 12rpx;
  padding: 10rpx 26rpx;
}
