.login-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; }

.login-card {
  width: calc(100% - 96rpx);
  margin-top: 140rpx;
  background: var(--pg-card);
  border-radius: 40rpx;
  box-shadow: var(--pg-shadow-lg);
  padding: 64rpx 48rpx 56rpx;
  display: flex; flex-direction: column; align-items: center;
}

.brand { position: relative; }
.brand-glow {
  position: absolute; left: 50%; top: 50%;
  width: 320rpx; height: 320rpx; transform: translate(-50%, -50%);
  /* 图标本身已是深青方块，光晕调淡一点，避免"两层青"糊成一片 */
  background: radial-gradient(circle, rgba(12, 139, 128, 0.11) 0%, rgba(12, 139, 128, 0) 70%);
  border-radius: 50%;
}
.brand-logo { width: 200rpx; height: 200rpx; position: relative; }

.app-name { font-size: 44rpx; font-weight: 700; color: var(--pg-ink); margin-top: 48rpx; letter-spacing: 2rpx; }
.app-slogan { font-size: 26rpx; color: var(--pg-ink-3); margin-top: 14rpx; }

.status-area { margin-top: 60rpx; display: flex; flex-direction: column; align-items: center; width: 100%; }
.st-loading { display: flex; align-items: center; color: var(--pg-ink-2); font-size: 27rpx; }
.st-dot {
  width: 28rpx; height: 28rpx; border-radius: 50%;
  border: 4rpx solid var(--pg-primary-soft); border-top-color: var(--pg-primary);
  margin-right: 16rpx;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.st-error {
  background: var(--pg-danger-soft); color: var(--pg-danger);
  font-size: 25rpx; line-height: 1.6;
  padding: 20rpx 24rpx; border-radius: 16rpx;
  text-align: center; width: 100%; box-sizing: border-box;
}
.st-btn { margin-top: 36rpx; width: 100%; }
.st-link { margin-top: 28rpx; font-size: 24rpx; color: var(--pg-primary); text-align: center; }
.st-now { margin-top: 12rpx; font-size: 21rpx; color: var(--pg-ink-4); text-align: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.login-footer { margin-top: auto; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; }
.f-line { font-size: 22rpx; color: var(--pg-ink-4); }
.f-link { font-size: 22rpx; color: var(--pg-ink-4); margin-top: 10rpx; opacity: 0.7; }

/* 服务地址弹层（沿用「我的」页的视觉语言，本页自包含） */
.bs-tip { font-size: 24rpx; color: var(--pg-ink-3); line-height: 1.7; }
.bs-input-box {
  background: var(--pg-fill); border-radius: 16rpx;
  padding: 4rpx 24rpx; margin-top: 24rpx;
}
.bs-input { height: 84rpx; font-size: 28rpx; color: var(--pg-ink); }
.bs-presets { display: flex; gap: 16rpx; margin-top: 20rpx; }
.bs-save { margin-top: 32rpx; }

/* 登录后补齐头像/昵称（官方填写能力） */
.pf-avatar-row { display: flex; justify-content: center; margin-top: 40rpx; }
/* 头像框是普通 view；真正的 open-type=chooseAvatar button 作为透明热区盖在上面 */
.pf-avatar-btn {
  position: relative;
  width: 160rpx; height: 160rpx; padding: 0; margin: 0;
  border: 3rpx dashed var(--pg-line); border-radius: 50%;
  background: var(--pg-fill); overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--pg-ink-3);
}
.pf-avatar-hit {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  padding: 0; margin: 0; background: transparent; border-radius: 50%;
}
.pf-avatar-hit::after { border: none; }
.pf-avatar { width: 100%; height: 100%; border-radius: 50%; }
.pf-avatar-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--pg-ink-3);
}
.pf-input-box {
  background: var(--pg-fill); border-radius: 16rpx;
  padding: 4rpx 24rpx; margin-top: 32rpx;
}
.pf-input { height: 84rpx; font-size: 28rpx; color: var(--pg-ink); text-align: center; }
.pf-acts { margin-top: 36rpx; width: 100%; }
.pf-skip { text-align: center; font-size: 24rpx; color: var(--pg-ink-3); margin-top: 20rpx; }

/* ---------- 服务地址：最近使用 / 局域网扫描 ---------- */
.bs-cap {
  display: flex; align-items: center; justify-content: space-between;
  margin: 28rpx 0 12rpx; font-size: 24rpx; color: var(--pg-ink-3);
}
.bs-cap-act { color: var(--pg-primary); padding: 4rpx 8rpx; }

.bs-list { display: flex; flex-direction: column; gap: 10rpx; }
.bs-item {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 22rpx; border-radius: 16rpx;
  background: var(--pg-primary-softer, #F3FAF9);
  border: 1rpx solid rgba(12, 139, 128, 0.12);
}
.bs-item-hit { background: var(--pg-primary-soft, #E7F5F3); border-color: rgba(12, 139, 128, 0.3); }
.bs-ico { width: 34rpx; height: 34rpx; flex: none; }
.bs-txt {
  flex: 1; font-size: 26rpx; color: var(--pg-ink);
  word-break: break-all; line-height: 1.4;
}
.bs-go { font-size: 34rpx; color: var(--pg-ink-4); line-height: 1; }
.bs-item-main { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.bs-sub { font-size: 22rpx; color: var(--pg-primary); }
.bs-add {
  flex: none; font-size: 24rpx; color: #fff; background: var(--pg-primary);
  padding: 8rpx 20rpx; border-radius: 999rpx;
}

.bs-scan { display: flex; align-items: center; gap: 14rpx; }
.bs-scan-in {
  flex: 1; height: 76rpx; padding: 0 20rpx; font-size: 26rpx;
  background: #F5F7F8; border-radius: 14rpx; color: var(--pg-ink);
}
.bs-scan-btn { flex: none; min-width: 130rpx; justify-content: center; }
.bs-scan-btn.on { color: #fff; background: var(--pg-ink-3); border-color: transparent; }

.bs-progress { margin-top: 16rpx; }
.bs-progress-bar {
  height: 8rpx; border-radius: 999rpx; background: #E8EDEF; overflow: hidden;
}
.bs-progress-fill {
  height: 100%; background: var(--pg-primary); border-radius: 999rpx;
  transition: width 0.2s ease;
}
.bs-progress-txt { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--pg-ink-3); }

.bs-empty {
  margin-top: 16rpx; padding: 18rpx 20rpx; border-radius: 14rpx;
  background: #FFF8EC; color: #8A5B00; font-size: 22rpx; line-height: 1.6;
}
