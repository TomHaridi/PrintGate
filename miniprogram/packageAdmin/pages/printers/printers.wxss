.denied-tip { text-align: center; color: var(--pg-ink-3); font-size: 26rpx; padding: 80rpx 0; }
.empty-tip { text-align: center; color: var(--pg-ink-3); font-size: 24rpx; padding: 80rpx 0; }

.p-card-box { padding: 24rpx 26rpx; }
.p-title-row { display: flex; align-items: center; justify-content: space-between; }
.p-name { font-size: 28rpx; font-weight: 600; color: var(--pg-ink); flex: 1; min-width: 0; margin-right: 16rpx; }
.p-info { font-size: 22rpx; color: var(--pg-ink-3); margin-top: 10rpx; }
.p-default-line { font-size: 21rpx; color: var(--pg-primary); margin-top: 8rpx; }
.p-acts { display: flex; gap: 14rpx; margin-top: 20rpx; }
.p-btn {
  font-size: 24rpx; color: var(--pg-ink-2);
  background: var(--pg-fill); border-radius: 12rpx;
  padding: 14rpx 30rpx;
}
.p-btn-primary { color: var(--pg-on-primary); background: var(--pg-primary); }
