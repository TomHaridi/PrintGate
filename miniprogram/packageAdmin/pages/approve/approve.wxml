<view class="page admin-approve {{dark ? 'theme-dark' : ''}}" style="{{primaryStyle}}">
  <nav-bar title="任务审批" show-back  center />

  <view class="card filter-card">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tabs">
      <view class="tab-wrap">
        <view class="tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{denied}}" class="denied-tip">仅管理员可审批任务</view>
  <view wx:elif="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{tasks.length > 0}}">
    <view class="t-row" wx:for="{{tasks}}" wx:key="id">
      <view class="t-head">
        <status-tag text="{{item._state}}" kind="{{item._stateKind}}" dot />
        <view class="t-time">{{item._time}}</view>
      </view>
      <view class="t-name ellipsis">{{item._name}}</view>
      <view class="t-meta">
        <text>{{item.nickname || '未知用户'}}</text>
        <text>{{item.printer}}</text>
        <text>{{item._summary}}</text>
      </view>
      <view class="t-error" wx:if="{{item.error}}">{{item.error}}</view>
      <view class="t-acts" wx:if="{{item._canAct}}">
        <view class="t-btn t-btn-ok" bindtap="askAction" data-id="{{item.id}}" data-action="approve">放行</view>
        <view class="t-btn t-btn-del" bindtap="askAction" data-id="{{item.id}}" data-action="reject">拒绝</view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-tip">没有符合条件的任务</view>

  <pg-dialog
    visible="{{actionVisible}}"
    title="{{actionTitle}}"
    content="确认{{actionTitle}}「{{actionTarget.filename}}」？"
    ok-text="{{actionOkText}}"
    danger="{{actionFn === 'reject'}}"
    bind:cancel="closeAction"
    bind:ok="confirmAction"
  />
</view>
