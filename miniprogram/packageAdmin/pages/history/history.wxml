<view class="page admin-history {{dark ? 'theme-dark' : ''}}" style="{{primaryStyle}}">
  <nav-bar title="打印历史" show-back  center />

  <view class="card filter-card">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tabs">
      <view class="tab-wrap">
        <view class="tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 清除历史入口 -->
  <view class="clean-bar">
    <view class="clean-hint">清除已结束的打印记录（进行中的不受影响）</view>
    <view class="btn btn-ghost btn-sm" bindtap="askClean" data-status="">清除全部已结束</view>
  </view>

  <view wx:if="{{denied}}" class="denied-tip">仅管理员可查看打印历史</view>
  <view wx:elif="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{tasks.length > 0}}">
    <view class="t-row" wx:for="{{tasks}}" wx:key="id">
      <view class="t-head">
        <status-tag text="{{item._state}}" kind="{{item._stateKind}}" dot />
        <view class="t-time">{{item._time}}</view>
      </view>
      <view class="t-name ellipsis">{{item._name}}</view>
      <view class="t-meta">
        <text>{{item.nickname || '未知用户'}}</text>
        <text>{{item._printer}}</text>
        <text>{{item._summary}}</text>
      </view>
      <view class="t-error" wx:if="{{item.error}}">{{item.error}}</view>
    </view>
  </block>

  <view wx:else class="empty-tip">没有符合条件的打印记录</view>

  <pg-dialog
    visible="{{cleanVisible}}"
    title="清除打印历史"
    content="确定清除「{{cleanLabel}}」吗？进行中的任务不受影响，此操作不可撤销。"
    ok-text="清除"
    danger
    bind:cancel="closeClean"
    bind:ok="confirmClean"
  />
</view>
