<view class="mask {{dark ? 'theme-dark' : ''}}" wx:if="{{visible}}" bindtap="onMask">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head">
      <view class="sheet-title">{{title}}</view>
      <view class="sheet-close" wx:if="{{showClose}}" bindtap="onMask">×</view>
    </view>
    <view class="sheet-body">
      <slot />
    </view>
  </view>
</view>
