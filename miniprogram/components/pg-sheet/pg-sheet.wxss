/* 自包含 token：与 app.wxss 一致，保证组件内暗夜可靠 */
.mask {
  --pg-mask: rgba(22, 38, 46, 0.5);
  --pg-card: #FFFFFF;
  --pg-ink: #16262E;
  --pg-fill: #EFF2F4;
  --pg-ink-3: #7C8B94;
}
.mask.theme-dark {
  --pg-mask: rgba(0, 0, 0, 0.62);
  --pg-card: #1A242A;
  --pg-ink: #E8EEF0;
  --pg-fill: #222F36;
  --pg-ink-3: #7A8B92;
}
.mask {
  position: fixed; inset: 0; z-index: 1000;
  background: var(--pg-mask);
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: var(--pg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 12rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: up 0.22s ease-out;
  max-height: 82vh; display: flex; flex-direction: column;
}
@keyframes up { from { transform: translateY(30%); opacity: 0.5; } to { transform: translateY(0); opacity: 1; } }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0 8rpx; }
.sheet-title { font-size: 32rpx; font-weight: 600; color: var(--pg-ink); }
.sheet-close {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--pg-fill); color: var(--pg-ink-3);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}
.sheet-body { overflow-y: auto; }
