/* 自包含 token：与 app.wxss 一致，保证组件内暗夜可靠 */
.empty {
  --pg-ink-3: #7C8B94;
}
.empty.theme-dark {
  --pg-ink-3: #7A8B92;
}
.empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0 60rpx; }
.empty image { width: 260rpx; height: 260rpx; opacity: 0.9; }
.empty-text { font-size: 26rpx; color: var(--pg-ink-3); margin-top: 12rpx; }
.empty-btn { margin-top: 32rpx; }
.btn-ghost { background: var(--pg-primary-soft, #E7F5F3); color: var(--pg-primary, #0C8B80); }
.btn-sm { height: 64rpx; font-size: 26rpx; border-radius: 14rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; }
