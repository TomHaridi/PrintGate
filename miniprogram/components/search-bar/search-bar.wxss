/* 自包含 token：与 app.wxss 一致，保证组件内暗夜可靠 */
.search-bar {
  --pg-card: #FFFFFF;
  --pg-fill: #EFF2F4;
  --pg-ink: #16262E;
  --pg-ink-3: #7C8B94;
  --pg-shadow: 0 6rpx 24rpx rgba(22, 38, 46, 0.06);
}
.search-bar.theme-dark {
  --pg-card: #1A242A;
  --pg-fill: #222F36;
  --pg-ink: #E8EEF0;
  --pg-ink-3: #7A8B92;
  --pg-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.35);
}
.search-bar { padding: 8rpx 24rpx 16rpx; }
.search-bar .box {
  display: flex; align-items: center;
  height: 72rpx; border-radius: 36rpx;
  background: var(--pg-card);
  padding: 0 24rpx;
  box-shadow: var(--pg-shadow);
}
.search-bar .icon { width: 32rpx; height: 32rpx; margin-right: 14rpx; flex-shrink: 0; }
.search-bar .input { flex: 1; font-size: 26rpx; color: var(--pg-ink); min-width: 0; }
.search-bar .ph { color: var(--pg-ink-3); }
.search-bar .clear {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--pg-fill); color: var(--pg-ink-3);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; flex-shrink: 0;
}
